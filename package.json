{
  "name": "keylane",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <27"
  },
  "scripts": {
    "dev": "next dev --port 5189",
    "build": "next build",
    "start": "next start --port 5189",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=2 tests/*.test.ts",
    "test:rooms": "node tests/rooms-smoke.mjs",
    "test:load": "node tests/rooms-load.mjs",
    "test:ui": "node --import ./tests/dom-setup.mjs --import tsx --test --test-concurrency=1 tests/*ui.test.tsx",
    "check": "npm test && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@solar-icons/react": "^2.3.2",
    "@vercel/functions": "^3.10.1",
    "drizzle-orm": "0.45.2",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.2",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
